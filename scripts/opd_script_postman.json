          "script": {
            "exec": [
              "// Logout dilakukan client-side dengan menghapus token",
              "// Pada Postman, kita hapus variable jwt_token dari environment",
              "pm.environment.unset(\"jwt_token\");",
              "console.log(\"Token berhasil dihapus. OPD telah logout.\");"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Token sudah dihapus dari environment\", function () {",
              "    var token = pm.environment.get(\"jwt_token\");",
              "    pm.expect(token).to.be.undefined;",
              "});",
              "",
              "pm.test(\"Request tanpa token ditolak (401/403)\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
              "});"
            ],
            "type": "text/javascript"
          }
