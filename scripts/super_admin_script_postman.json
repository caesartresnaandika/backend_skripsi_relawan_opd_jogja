              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.user.role).to.equal('super_admin');",
              "});",
              "",
              "// Auto-simpan token ke environment",
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
