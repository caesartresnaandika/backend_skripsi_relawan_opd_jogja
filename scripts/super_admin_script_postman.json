    {
      "name": "12. Unggah Surat Keputusan (SK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Jika file PDF tidak dilampirkan, server akan menolak dengan 400",
              "// Jika file dilampirkan, server akan menerima dengan 200/201",
              "pm.test(\"Response valid (201 jika file dilampirkan, 400 jika tanpa file)\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400]);",
              "});",
              "",
              "pm.test(\"Response memiliki pesan yang sesuai\", function () {",
              "    var jsonData = pm.response.json();",
              "    if (pm.response.code === 400) {",
              "        pm.expect(jsonData.message).to.include('File PDF SK wajib diunggah');",
              "    } else {",
              "        pm.expect(jsonData.success).to.be.true;",
              "    }",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
